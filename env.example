# ═══ Voice Gateway — environment (Layer 1: GatewayConfig, GATEWAY_*) ═══
# Reference: app/gateway_service/DEPENDENCIES.md and
# docs/voice-gateway-phase1-standalone.md §2.5. Copy to .env and edit.

# ── The gateway process itself ──────────────────────────────────────────
# The app↔gateway PAIR secret (static; decision 2026-08-25 — service-to-
# service edges use one static key per pair). Presented by the app on
# /v1/tenants/... calls; presented BY the gateway on its status relay back.
# Same value as the app env's GATEWAY_SERVICE_KEY. EMPTY = auth off (dev).
GATEWAY_SERVICE_KEY=

# Public base URL for this gateway — REQUIRED for phone calls: Twilio
# fetches the TwiML webhook and connects the media stream here, so it must
# be reachable from the internet (ngrok in dev, the real host in prod).
# Widget/text calls derive it from the request when unset.
GATEWAY_PUBLIC_BASE_URL=

# Session store — the gateway's ONE persistence dependency.
#   memory : single process, dev/text (records die with the process)
#   redis  : production (uses REDIS_URL below; refuses to boot redis-less)
GATEWAY_SESSION_STORE=memory

# Per-tenant config overrides (Layer 2: TenantProfile v1), a JSON file of
# {tenant: {field: value}}. Empty = built-in defaults for every tenant.
GATEWAY_TENANT_PROFILES=

# Missing-capability policy (AEC / VAD / audioop, checked at boot):
#   refuse : do not start degraded (default — phone deployments)
#   warn   : log ERROR lines and continue (dev boxes, text-only)
GATEWAY_CAPABILITY_POLICY=refuse

# ── Shared credentials the gateway half uses (same .env as the app in M1) ──
# Comments go on their own lines here: after an EMPTY value, dotenv reads an inline
# comment as the value (DEEPGRAM_API_KEY= # ... loaded the key "# ...", 2026-10-11).
# STT (flux) + TTS (aura-2)
DEEPGRAM_API_KEY=
# the REST dial + warm transfer
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# the semantic barge judge (decision D1) and the front model
CEREBRAS_API_KEY=

# ── The front model — the filler's source of words (docs/voice-gateway-front-model.md)
# DEFAULT ON. Set FRONT_MODEL_ENABLED=0 to fall back to the canned FillerPolicy
# phrases (which still need the assistant's enable_empathy_fillers flag).
# Read by THIS process; the turn service does not gate on it.
# FRONT_ENGINE=jev                   # jev (default) | llm | off
#   jev  one decisions call reads what move the DESK will open with, plus
#        riders; the words come from pools linted at load, so a misread costs
#        a WRONG line, never an unsafe one. Needs OPEN_ROUTER_API_KEY.
#        Design + the survey behind it: docs/FRONT_COMPLEMENT_DESIGN.md
#   llm  the original free-text composer (docs/voice-gateway-front-model.md)
#   off  beats only, the pre-model behaviour
# The gateway's own decisions calls (the front model's move, the line detector's
# recording question) go to Jev over OpenRouter (app/gateway/jev.py).
# OPEN_ROUTER_API_KEY=              # required for FRONT_ENGINE=jev and line detection
# JEV_MODEL=typesafe/jev-1.13
# JEV_TIMEOUT_MS=4000               # one decisions call sits on the turn's critical path
# FRONT_MOVE_FLOOR=0.45              # below this confidence on the desk move, say nothing
# FRONT_REPEAT_ENABLED=1             # when the caller missed what we said, say only
#                                    # "Sorry about that." — the desk re-delivers the content
# FRONT_MODEL_ENABLED=1
# FRONT_MODEL=qwen-3.8-27b           # Cerebras model id
# FRONT_MODEL_EFFORT=none            # reasoning_effort: none | low | default
# FRONT_CONFIG_PATH=                 # the front model's config (domain content: the prompt,
#                                    # the pools, must_not_say). Empty = the model tier is OFF
#                                    # and the hold uses the call's FillerPolicy pools.
#                                    # examples/front.yaml is a neutral template to copy.
# FRONT_BUDGET_MS=500                # the timing knobs: docs/voice-timing-constants.md §8
# FRONT_BEAT_AFTER_MS=900          # also the model request's timeout
# FRONT_BEAT_AFTER_EMPTY_MS=1500   # beat later when the model chose silence
# FRONT_WAIT_AGAIN_AFTER_MS=2500
# FRONT_MAX_WORDS=12
# FRONT_MIN_GAP_SEC=6
# S3_ENABLED=true            # optional recording upload
# S3_BUCKET=
# S3_REGION=
# REDIS_URL=                 # when GATEWAY_SESSION_STORE=redis

# ═══ Application-side cutover (goes in the APP's env, NOT the gateway's) ═══
# Setting GATEWAY_URL makes the application's initiate routes create calls ON the
# gateway (item-5 remainder). Empty = the monolith path, unchanged.
# GATEWAY_URL=http://127.0.0.1:8010
# GATEWAY_SERVICE_KEY=<same value as the gateway env>
# APP_SELF_URL=http://127.0.0.1:8001   # where the gateway reaches /turn/v1
                                       # and /api/v1/gateway/status
# TURN_SERVICE_API_KEY=<gateway↔turn pair secret; set the SAME value in
#                        both envs — nothing per-call is stored>
